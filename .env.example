# 复制为 .env 后生效：cp .env.example .env
# 不复制也能跑，docker-compose.yml 里每一项都有相同的默认值

XIAOZHI_TAG=latest       # 镜像版本，线上建议钉具体版本号

# ---- 端口 ----
WEB_PORT=8084            # 管理界面
SERVER_PORT=8091         # 后台 API + OTA
DIALOGUE_PORT=8092       # 设备 WebSocket
MYSQL_PORT=13306         # 只监听回环

# ---- 数据库 ----
MYSQL_DATABASE=xiaozhi
MYSQL_USER=xiaozhi
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=abc123456

# ---- 运行环境 ----
SPRING_PROFILES_ACTIVE=dev   # 生产改 prod
TZ=Asia/Shanghai

# 下发给设备的服务器 IP。Linux 可留空自动探测；
# macOS / Windows 的 Docker Desktop 探测不到局域网 IP，Windows 可运行
# scripts\sync-host-ip.ps1 自动写入（IP 变了重跑一次再 docker compose up -d）
HOST_IP=

# 设备接入鉴权密钥，留空等于不设防。对外部署前生成一个：openssl rand -hex 16
XIAOZHI_DEVICE_AUTH_SECRET=

# ---- MQTT（老年关怀模块）----
# Broker 连接串（compose 内走服务名 mosquitto；本机开发可 tcp://localhost:1883）
MQTT_BROKER=tcp://mosquitto:1883
# 后端服务账号（deploy/mosquitto/passwd 里同名条目必须一致）
MQTT_USERNAME=zhiliao-server
# 生产部署前必须改！与 scripts/generate-mqtt-passwd.sh 配套
MQTT_PASSWORD=zhiliao-mqtt-2026
# 宿主机联调端口（MQTTX 用，只映射回环）
MQTT_PORT=1883

# ---- 以下仅在从源码构建镜像时生效 ----
BUILD_PROXY=                        # 构建期下载代理，如 http://host.docker.internal:10808
VOSK_MODEL_SIZE=small               # 兜底识别模型：small / standard / none
TTS_MODEL=vits-melo-tts-zh_en       # 本地合成模型：vits-melo-tts-zh_en / matcha-icefall-zh-en / none
